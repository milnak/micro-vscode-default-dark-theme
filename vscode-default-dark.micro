# vscode-default-dark.micro
# (loosely) based on Visual Studio Code "Dark 2026 (Default Dark)" theme.
color-link color-column "#848484"
color-link comment "#8B949E"
color-link constant "#569CD6"
color-link constant.bool "#4B9CB1"
color-link constant.bool.false "#569CD6"
color-link constant.bool.true "#569CD6"
color-link constant.number "#B5CEA8"
color-link constant.specialChar "#B1BA70"
color-link constant.string "#A5D6F0"
color-link constant.string.url "underlined #A5D6FF"
color-link current-line-number "#BBBEBF,#E9F2FA"
color-link cursor-line "#191A1B"
color-link default "#C9D1D9,#121314"
color-link diff-added "#5FAF87"
color-link diff-deleted "#D75F5F"
color-link diff-modified "#101010"
color-link divider "#121314,#272829"
color-link error "bold #EB4B4B"
color-link error-message "#CCA700,#2C2D2E"
color-link hlsearch "#BBBEBF,#1D3D4B"
color-link identifier "#63CCFE"
color-link identifier.class "#FF7B57"
color-link identifier.var "#C9D1D9"
color-link line-number "#768889,#121314"
color-link match-brace "#F0D707"
color-link message "#CEEDE1,#2C2D2E"
color-link preproc "#C586C0"
color-link scrollbar "#616163"
color-link selection ",#245C74"
color-link special "#C586C0"
color-link statement "#C586C0"
color-link statusline "#8C8C8C,#191A1B"
color-link statusline.inactive "#2A2B2C,#191A1B"
color-link statusline.suggestions "#BFBAB5"
color-link symbol "#BBBEBF"
color-link symbol.brackets "#FFB30E"
color-link symbol.operator "#D4D4AF"
color-link symbol.tag  "#5EE778"
color-link tab-error "#200000"
color-link tabbar "#EDEDED,#202122"
color-link tabbar.active "#E8875C,#121314"
color-link todo "#FF7B72"
color-link trailingws "#373738"
color-link type "#4EC9B0"
color-link type.keyword "#FF7B72"
color-link underlined "underlined"

# The following haven't been assigned yet, as I haven't found cases where they're used.
# For now, I've set them to red on green to make it obvious to spot.
color-link comment.bright "#800000,#008000"
color-link constant.string.char "#800000,#008000"
color-link gutter-error "#800000,#008000"
color-link gutter-info "#800000,#008000"
color-link gutter-warning "#800000,#008000"
color-link identifier.macro "#800000,#008000"
color-link ignore "#800000,#008000"
color-link indent-char "#800000,#008000"
color-link preproc.shebang  "#800000,#008000"
